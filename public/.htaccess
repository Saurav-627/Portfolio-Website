# Enable URL rewriting
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Do not rewrite the main index.html
  RewriteRule ^index\.html$ - [L]

  # If the requested URL is not a real file or directory, redirect to index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Optional: Set default character encoding
AddDefaultCharset UTF-8

# Optional: Set cache for static assets (images, JS, CSS)
<FilesMatch "\.(js|css|png|jpg|jpeg|gif|svg|ico)$">
  ExpiresActive On
  ExpiresDefault "access plus 1 year"
</FilesMatch>